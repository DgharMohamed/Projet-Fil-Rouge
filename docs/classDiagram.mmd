---
title: Projet Fil Rouge - Architecture 3 tiers (Session 3)
config:
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction TB

    namespace Presentation {
        class FrontendApp["index.html + app.js"] {
            -object state
            +Promise api(string url, object options)
            +Promise reload()
            +void render()
            +void toast(string message, string type)
        }
    }

    namespace API {
        class apiDomainePHP["apiDomaine.php"] {
            <<api>>
        }

        class apiOffrePHP["apiOffre.php"] {
            <<api>>
        }
    }

    namespace Services {
        class BaseService {
            <<abstract>>
        }

        class DomaineService {
            -DomaineDAO domaineDao
            -OffreDAO offreDao
            +array listerDomaines()
            +array ajouterDomaine()
            +array modifierDomaine()
            +array supprimerDomaine()
        }

        class OffreService {
            -OffreDAO offreDao
            -DomaineDAO domaineDao
            +array listerOffres()
            +array ajouterOffre()
            +array modifierOffre()
            +array supprimerOffre()
            -void VerifierChamps(array data, array keys)
            -string ChampTexte(array data, string key)
            -void VerifierDomaineExiste(int domaineId)
        }
    }

    namespace DAO {
        class DomaineDAO {
            -string dataFile
            +array AfficherTous()
            +Domaine TrouverParId(int id)
            +int ProchainId()
            +void Ajouter(Domaine domaine)
            +void Modifier(Domaine domaine)
            +Domaine Supprimer(int id)
            -array Charger()
            -void Enregistrer(array domaines)
        }

        class OffreDAO {
            -string dataFile
            +array AfficherTous()
            +Offre TrouverParId(int id)
            +int ProchainId()
            +int CompterParDomaine(int domaineId)
            +void Ajouter(Offre offre)
            +void Modifier(Offre offre)
            +Offre Supprimer(int id)
            -array Charger()
            -void Enregistrer(array offres)
        }
    }

    namespace Modeles {
        class Domaine {
            -int id
            -string nom
            +int getId()
            +void setId(int id)
            +string getNom()
            +void setNom(string nom)
            +array toArray()
            +Domaine fromArray(array data)$
        }

        class Offre {
            -int id
            -string titre
            -string description
            -float salaire
            -int domaineId
            +int getId()
            +void setId(int id)
            +string getTitre()
            +void setTitre(string titre)
            +string getDescription()
            +void setDescription(string description)
            +float getSalaire()
            +void setSalaire(int|float|string salaire)
            +int getDomaineId()
            +void setDomaineId(int domaineId)
            +array toArray()
            +Offre fromArray(array data)$
        }
    }

    DomaineService --|> BaseService
    OffreService --|> BaseService

    FrontendApp ..> apiDomainePHP : HTTP / JSON
    FrontendApp ..> apiOffrePHP : HTTP / JSON
    apiDomainePHP ..> DomaineService : appelle
    apiOffrePHP ..> OffreService : appelle

    DomaineService --> DomaineDAO : utilise
    DomaineService --> OffreDAO : compte les offres liees
    OffreService --> OffreDAO : utilise
    OffreService --> DomaineDAO : verifie le domaine

    DomaineDAO ..> Domaine : fromArray / toArray
    OffreDAO ..> Offre : fromArray / toArray

    Offre "n" --> "1" Domaine : domaine_id (FK)

    note for DomaineDAO "Seule couche qui lit et écrit les fichiers JSON"
    note for DomaineService "Valide les données et applique les règles métier (codes 200, 201, 400, 404, 409, 422)"
